---
import { icons, type IconName } from './icons';

interface Props {
	name: IconName;
	size?: number;
	class?: string;
}

const { name, size = 18, class: className } = Astro.props;
---

<svg
	xmlns="http://www.w3.org/2000/svg"
	width={size}
	height={size}
	viewBox="0 0 24 24"
	aria-hidden="true"
	focusable="false"
	class:list={['px-icon', className]}
	set:html={icons[name]}
/>

<style>
	.px-icon {
		display: block;
		flex-shrink: 0;
	}
</style>
